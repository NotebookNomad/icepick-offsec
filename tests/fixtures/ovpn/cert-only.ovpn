# Synthetic fixture - NOT a working config, no real key material.
# Shape mirrors an HTB lab config: cert-only, connects unattended.
client
dev tun
proto udp
remote lab.example.net 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM
verb 3
<ca>
-----BEGIN CERTIFICATE-----
RkFLRSAtIHRlc3QgZml4dHVyZSBvbmx5IC0gbm90IGEgcmVhbCBjZXJ0aWZpY2F0ZQ==
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
RkFLRSAtIHRlc3QgZml4dHVyZSBvbmx5IC0gbm90IGEgcmVhbCBjZXJ0aWZpY2F0ZQ==
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
RkFLRSAtIHRlc3QgZml4dHVyZSBvbmx5IC0gbm90IGEgcmVhbCBwcml2YXRlIGtleQ==
-----END PRIVATE KEY-----
</key>
