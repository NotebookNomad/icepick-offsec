# Synthetic fixture - NOT a working config, no real key material.
# Shape mirrors a config that prompts for a username/password, so the daemon
# start in vpn-connect never completes a handshake.
client
dev tun
proto udp
remote gw.eu-central-1.example.net 1194
remote gw.eu-west-1.example.net 1194
auth-user-pass
resolv-retry infinite
nobind
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
verb 3
<ca>
-----BEGIN CERTIFICATE-----
RkFLRSAtIHRlc3QgZml4dHVyZSBvbmx5IC0gbm90IGEgcmVhbCBjZXJ0aWZpY2F0ZQ==
-----END CERTIFICATE-----
</ca>
<tls-auth>
-----BEGIN OpenVPN Static key V1-----
RkFLRSAtIHRlc3QgZml4dHVyZSBvbmx5
-----END OpenVPN Static key V1-----
</tls-auth>
key-direction 1
