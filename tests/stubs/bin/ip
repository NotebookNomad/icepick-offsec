#!/usr/bin/env bash
# Fake iproute2. Behaviour is driven by env vars the test sets:
#   STUB_IP_ROUTE   text after "src" is what deck extracts; "noroute" => exit 2
#   STUB_IP_ADDRS   file of `ip -o -4 addr show scope global` lines
#   STUB_TUN        one `ip -o` line for tun0; empty => tun0 absent
#   STUB_ETH_NET    `ip -o route show scope link dev eth0` line
#   STUB_GW         `ip route show default dev eth0` line
printf 'ip %s\n' "$*" >> "${STUB_CALLLOG:-/dev/null}"

case "$*" in
  "route get 1.1.1.1")
    case "${STUB_IP_ROUTE:-}" in
      noroute) echo "RTNETLINK answers: Network is unreachable" >&2; exit 2 ;;
      "")      exit 0 ;;
      *)       printf '%s\n' "$STUB_IP_ROUTE" ;;
    esac ;;
  "-o -4 addr show scope global")
    [ -n "${STUB_IP_ADDRS:-}" ] && [ -f "${STUB_IP_ADDRS}" ] && cat "$STUB_IP_ADDRS"
    exit 0 ;;
  "-o -4 addr show tun0")
    if [ -n "${STUB_TUN:-}" ]; then printf '%s\n' "$STUB_TUN"; exit 0; fi
    echo 'Device "tun0" does not exist.' >&2; exit 1 ;;
  "link show tun0")
    [ -n "${STUB_TUN:-}" ] && exit 0
    echo 'Device "tun0" does not exist.' >&2; exit 1 ;;
  "-o route show scope link dev eth0")
    printf '%s\n' "${STUB_ETH_NET:-172.24.0.0/24 dev eth0 proto kernel scope link src 172.24.0.5}" ;;
  "route show default dev eth0")
    printf '%s\n' "${STUB_GW:-default via 172.24.0.1 dev eth0}" ;;
  *) exit 0 ;;
esac
