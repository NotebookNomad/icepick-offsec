# Engagement data - never commit this. workspace/ accumulates loot, notes,
# scope files, target lists and CTF binaries. deck recreates the dir on demand,
# so only the placeholder is tracked.
workspace/*
!workspace/.gitkeep

# VPN configs and any credentials beside them. The directory is tracked so a
# fresh clone has somewhere to drop one; nothing inside it is.
vpn/*
!vpn/.gitkeep
!vpn/README.md

# Local tooling state and credentials.
.claude/
.env
*.ovpn
*.pem
*.key

# ...but the test suite's synthetic OpenVPN fixtures are not credentials -
# they carry no key material and are needed for the checkout to be complete.
!tests/fixtures/ovpn/*.ovpn
