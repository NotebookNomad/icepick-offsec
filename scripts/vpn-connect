#!/usr/bin/env bash
# Container-side of `deck vpn`: bring the tunnel up, then hand off to a login
# shell in this same container so tun0 and your shell share one network
# namespace. $OVPN is the config filename deck staged into ~/workspace;
# $SOCKS, if set, is the port `deck vpn --socks` published on the host.
set -euo pipefail

cfg="$HOME/workspace/${OVPN:?deck vpn sets this}"

# Start from an empty log: the wait loop greps it, and openvpn can fail during
# option parsing without ever opening it - leaving a previous run's success line
# in place to satisfy the grep instantly and report a tunnel that isn't there.
rm -f /tmp/openvpn.log

# Keep the status instead of `|| true`-ing it away: a config openvpn rejects
# must not abort under set -e, but it is also the one case where waiting is
# pointless, and 20s of silence is a poor answer to a config that already failed.
rc=0
openvpn --config "$cfg" --daemon --log /tmp/openvpn.log || rc=$?

# Wait for the handshake so we can report the tun0 IP; bail after 20s either way.
if [ "$rc" -eq 0 ]; then
  for _ in $(seq 1 20); do
    grep -q "Initialization Sequence Completed" /tmp/openvpn.log 2>/dev/null && break
    sleep 1
  done
fi

# `|| true` again: ip exits 1 when tun0 is absent, and a bare assignment takes
# the substitution's status - so under set -e this line, not the openvpn one,
# is what would kill the fallback it exists to reach.
tun=$(ip -o -4 addr show tun0 2>/dev/null || true)
if [ -n "$tun" ]; then
  echo "VPN up: $(awk 'NR == 1 { print $4 }' <<<"$tun")   (log: /tmp/openvpn.log)"
else
  echo "tun0 not up yet - tail /tmp/openvpn.log. auth-user-pass configs need a"
  echo "manual connect: openvpn --config $cfg"
fi

# The host has no route to the VPN, since tun0 lives in this container's netns.
# A SOCKS5 proxy here is the way a browser on the host reaches the target: every
# port in one hop, and names resolve on this side, so /etc/hosts vhost entries
# belong in this container rather than on the host.
if [ -n "${SOCKS:-}" ]; then
  # 0.0.0.0, not 127.0.0.1: a published port arrives from the bridge, so a
  # loopback bind would refuse the very connections this exists for. deck
  # publishes it to the host's loopback only - but it stays open to anything
  # else on the compose network, which is no auth away from your tunnel.
  microsocks -i 0.0.0.0 -p "$SOCKS" >/tmp/microsocks.log 2>&1 &
  socks_pid=$!
  # Confirm it is still alive before claiming it is up. microsocks exits on a
  # port already taken or below 1024, and announcing a proxy that died sends you
  # off to configure Firefox for a connection that will just be refused.
  sleep 0.3
  if kill -0 "$socks_pid" 2>/dev/null; then
    echo "SOCKS5 up on the host at 127.0.0.1:$SOCKS   (log: /tmp/microsocks.log)"
    echo "  Firefox : SOCKS v5, and tick 'Proxy DNS when using SOCKS v5'"
    echo "  Burp    : Network > Connections > SOCKS proxy, tick 'Do DNS lookups'"
    echo "  vhosts  : hosts add <ip> <name> - this container's /etc/hosts, not the Mac's"
  else
    echo "microsocks failed to start on port $SOCKS - see /tmp/microsocks.log" >&2
  fi
fi

exec zsh -l
