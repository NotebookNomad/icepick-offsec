#!/usr/bin/env bash
# Allow egress only through the VPN. The public internet, the provider's own
# network and the Docker host are all dropped, so a mistyped target or a tool
# that resolves outward cannot leave the tunnel. Needs NET_ADMIN.
#
# The inverse of lockdown-lan, and they do not compose. This one matches on the
# interface a packet leaves by, which is what makes it work with HTB/THM labs in
# 10.0.0.0/8 - the range lockdown-lan blocks outright.
#
#   lockdown-wan [config.ovpn]   defaults to $HOME/vpn/$OVPN
set -euo pipefail

cfg="${1:-}"
[ -n "$cfg" ] || cfg="${OVPN:+$HOME/vpn/$OVPN}"

# Fail closed, and every later judgement rests on it: a shell that believes it
# is firewalled but is not is worse than one that never started. The NET_ADMIN
# and iptables guards are shared with lockdown-lan; the tun0 check is ours.
# shellcheck source-path=SCRIPTDIR
. lockdown-common.sh
require_net_admin
require_iptables "egress is blocked"
if ! ip link show tun0 >/dev/null 2>&1; then
  echo "error: no tun0. Bring the VPN up first: deck vpn <file>.ovpn" >&2
  exit 1
fi

# The bridge subnet this container sits on, kept reachable so a published port -
# the SOCKS proxy - can still answer.
local_nets=$(ip -o route show scope link dev eth0 2>/dev/null | awk '{print $1}') || true
# The bridge gateway is the Docker host's own interface. Nothing in here needs
# it, and on a Linux host it is the real machine rather than a VM, so it gets
# dropped rather than swept up by the subnet allow above.
gw=$(ip route show default dev eth0 2>/dev/null | awk '{print $3; exit}') || true

iptables -F OUTPUT
iptables -A OUTPUT -o lo -j ACCEPT
# This rule must precede the gateway drop. A published port's replies travel
# back toward the gateway as an established flow, so the SOCKS proxy dies
# without it - and the symptom is a browser that hangs rather than an error.
iptables -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
if [ -n "$gw" ]; then
  echo ">> dropping host gateway $gw"
  iptables -A OUTPUT -d "$gw" -j DROP
fi
for net in $local_nets ${LOCAL_ALLOW_NETS:-}; do
  echo ">> permitting $net"
  iptables -A OUTPUT -d "$net" -j ACCEPT
done
echo ">> permitting tun0"
iptables -A OUTPUT -o tun0 -j ACCEPT

# Resolve the server now, while egress is still open - the policy flips to DROP
# below and a name looked up after that cannot resolve. Read the config rather
# than the openvpn log: it survives a log-format change, and it catches every
# `remote` line rather than only the one that happened to win.
if [ -n "$cfg" ] && [ -f "$cfg" ]; then
  for host in $(awk '/^[[:space:]]*remote /{print $2}' "$cfg" | sort -u); do
    resolved=0
    for a in $(getent ahostsv4 "$host" 2>/dev/null | awk '{print $1}' | sort -u); do
      echo ">> permitting VPN endpoint $host -> $a"
      iptables -A OUTPUT -d "$a" -j ACCEPT
      resolved=1
    done
    # Say so. Unresolved means no rule, which means the tunnel runs on its
    # established flow until the first re-handshake and then strands.
    if [ "$resolved" -eq 0 ]; then
      echo ">> WARNING: $host did not resolve - endpoint NOT permitted." >&2
      echo "   The tunnel cannot re-handshake; reconnect before locking down." >&2
    fi
  done
else
  echo ">> no .ovpn to read - the live tunnel survives on its established flow," >&2
  echo "   but openvpn will not be able to re-handshake if it drops." >&2
fi

iptables -P OUTPUT DROP

# This compose network is IPv4-only, but a host with IPv6 would otherwise leave
# a second way out standing wide open behind a firewall that looks complete.
if command -v ip6tables >/dev/null 2>&1 && ip6tables -L >/dev/null 2>&1; then
  ip6tables -F OUTPUT
  ip6tables -A OUTPUT -o lo -j ACCEPT
  ip6tables -A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  ip6tables -P OUTPUT DROP
  echo ">> IPv6 egress dropped"
else
  echo ">> WARNING: ip6tables unavailable - IPv6 egress is NOT blocked." >&2
fi

# iptables cannot close this one: Docker's resolver forwards upstream from
# outside this netns, so DNS never traverses OUTPUT and leaks past any rule.
# Emptying resolv.conf is the only fix from in here; lab names keep working via
# /etc/hosts. (Full reasoning: docs/networking.md, "Keeping traffic inside the
# VPN".) Write *through* the file - it is a bind mount, so `mv` fails with
# "Device or resource busy".
if [ "${KEEP_DNS:-0}" = "1" ]; then
  echo ">> WARNING: KEEP_DNS=1 - name lookups still leak to the host's resolver." >&2
else
  printf '# emptied by lockdown-wan: Docker DNS forwards outside the firewall.\n' > /etc/resolv.conf
  echo '>> DNS resolver emptied - use IPs, or: hosts add <ip> <name>'
fi

echo
echo "Egress locked to the VPN. Internet and host unreachable."
echo "Verify:  curl -m 3 https://example.com   (should fail)"
echo "         ping -c 2 <lab-ip>              (should work)"
echo "Rules are per container and die with the session."
